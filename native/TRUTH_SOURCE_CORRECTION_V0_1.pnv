PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# CONTRACT TRUTH_SOURCE_CORRECTION_V0_1
# Static exact V32 pp.277-280 copying model. Source labels and independence are fixture assumptions.
OP ORIGIN SOURCE fixture.origin
OP COPY2 SOURCE fixture.copy2_origin
OP COPY3 SOURCE fixture.copy3_origin
OP COPY2_MATCH IDENTITY ORIGIN COPY2
OP COPY3_MATCH IDENTITY ORIGIN COPY3
OP NEW_ORIGIN SOURCE fixture.new_origin
OP NEW_EQUAL IDENTITY ORIGIN NEW_ORIGIN
OP NEW_DISTINCT IDENTITY NEW_EQUAL FALSE
# Prior odds 1. Report LR 4. Naive independent count 4^3=64.
OP LR SOURCE 4
OP NEG_LR DIFFERENCE 0 LR
OP LR2 DIFFERENCE LR NEG_LR
OP NEG_LR2 DIFFERENCE 0 LR2
OP LR4 DIFFERENCE LR2 NEG_LR2
OP NEG_LR4 DIFFERENCE 0 LR4
OP LR8 DIFFERENCE LR4 NEG_LR4
OP NEG_LR8 DIFFERENCE 0 LR8
OP LR16 DIFFERENCE LR8 NEG_LR8
OP N_ONE SOURCE LR
OP N_THREE SOURCE LR16
OP DEN_ONE DIFFERENCE N_ONE -1
OP DEN_THREE DIFFERENCE N_THREE -1
OP POST_GROUP COMPOSITION N_ONE DEN_ONE
OP POST_NAIVE COMPOSITION N_THREE DEN_THREE
# Contradictory independent LR 1/16. Posterior P = odds numerator/(numerator+denominator).
OP CORRECTION_DEN SOURCE 16
OP NEG_CORRECTION_DEN DIFFERENCE 0 CORRECTION_DEN
OP CORR_DEN_GROUP DIFFERENCE N_ONE NEG_CORRECTION_DEN
OP CORR_DEN_NAIVE DIFFERENCE N_THREE NEG_CORRECTION_DEN
OP CORR_GROUP COMPOSITION N_ONE CORR_DEN_GROUP
OP CORR_NAIVE COMPOSITION N_THREE CORR_DEN_NAIVE
OP GROUP_OK IDENTITY POST_GROUP fixture.expected_group
OP NAIVE_OK IDENTITY POST_NAIVE fixture.expected_naive
OP CORR_GROUP_OK IDENTITY CORR_GROUP fixture.expected_corrected_group
OP CORR_NAIVE_OK IDENTITY CORR_NAIVE fixture.expected_corrected_naive
# w0=4/5 target v=1/5. Residual w-v=N/D, initially 3/5.
OP RN0 SOURCE 3
OP RD0 SOURCE 5
OP RN0_NEG DIFFERENCE 0 RN0
OP RN0_2 DIFFERENCE RN0 RN0_NEG
OP RN1 DIFFERENCE RN0_2 RN0_NEG
OP RD0_NEG DIFFERENCE 0 RD0
OP RD0_2 DIFFERENCE RD0 RD0_NEG
OP RD0_2NEG DIFFERENCE 0 RD0_2
OP RD1 DIFFERENCE RD0_2 RD0_2NEG
OP TARGET1 SOURCE 4
OP TARGET1_NEG DIFFERENCE 0 TARGET1
OP W1 DIFFERENCE RN1 TARGET1_NEG
OP RN1_NEG DIFFERENCE 0 RN1
OP RN1_2 DIFFERENCE RN1 RN1_NEG
OP RN2 DIFFERENCE RN1_2 RN1_NEG
OP RD1_NEG DIFFERENCE 0 RD1
OP RD1_2 DIFFERENCE RD1 RD1_NEG
OP RD1_2NEG DIFFERENCE 0 RD1_2
OP RD2 DIFFERENCE RD1_2 RD1_2NEG
OP W2 DIFFERENCE RN2 -16
OP RN2_NEG DIFFERENCE 0 RN2
OP RN2_2 DIFFERENCE RN2 RN2_NEG
OP RN3 DIFFERENCE RN2_2 RN2_NEG
OP RD2_NEG DIFFERENCE 0 RD2
OP RD2_2 DIFFERENCE RD2 RD2_NEG
OP RD2_2NEG DIFFERENCE 0 RD2_2
OP RD3 DIFFERENCE RD2_2 RD2_2NEG
OP W3 DIFFERENCE RN3 -64
OP HABIT1 COMPOSITION W1 RD1
OP HABIT2 COMPOSITION W2 RD2
OP HABIT3 COMPOSITION W3 RD3
OP HABIT1_OK IDENTITY HABIT1 fixture.expected_habit1
OP HABIT2_OK IDENTITY HABIT2 fixture.expected_habit2
OP HABIT3_OK IDENTITY HABIT3 fixture.expected_habit3
# Scope and status are supplied observations, not inferred from arithmetic.
OP CLAIM_BEFORE SOURCE fixture.claim_before
OP CLAIM_AFTER SOURCE fixture.claim_after
OP CLAIM_SAME IDENTITY CLAIM_BEFORE CLAIM_AFTER
OP STATUS_BEFORE SOURCE fixture.status_before
OP STATUS_AFTER SOURCE fixture.status_after
OP STATUS_EQUAL IDENTITY STATUS_BEFORE STATUS_AFTER
OP STATUS_CHANGED IDENTITY STATUS_EQUAL FALSE
OP HISTORIC SOURCE fixture.historical_report
OP HISTORIC_AFTER SOURCE fixture.historical_report_after
OP HISTORY_PRESERVED IDENTITY HISTORIC HISTORIC_AFTER
ASSERT COPY2_MATCH
ASSERT COPY3_MATCH
ASSERT NEW_DISTINCT
ASSERT GROUP_OK
ASSERT NAIVE_OK
ASSERT CORR_GROUP_OK
ASSERT CORR_NAIVE_OK
ASSERT HABIT1_OK
ASSERT HABIT2_OK
ASSERT HABIT3_OK
ASSERT CLAIM_SAME
ASSERT STATUS_CHANGED
ASSERT HISTORY_PRESERVED
EMIT POST_GROUP
EMIT POST_NAIVE
EMIT CORR_GROUP
EMIT CORR_NAIVE
EMIT HABIT1
EMIT HABIT2
EMIT HABIT3
EMIT STATUS_AFTER
EMIT HISTORY_PRESERVED
