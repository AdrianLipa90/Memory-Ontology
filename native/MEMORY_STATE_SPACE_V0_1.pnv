PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# CONTRACT MEMORY_STATE_SPACE_V0_1
# SOURCE_AUTHORITY PNCS_NATIVE_PNV_EXEC_TOOL_V0_1
# EXECUTION_STATUS UNVERIFIED_BINDINGS
# Inputs and pure transform bindings are specified in formalism/pncs-pnv-native-migration-v0.1.md.
OP M.STATE SOURCE memory.state
OP M.EVENT SOURCE memory.event
OP M.ARGS COMPOSITION M.STATE M.EVENT
OP M.NEXT TRANSFORM M.ARGS memory.verified_edge_update
OP M.QUERY SOURCE memory.query
OP M.BEFORE_ARGS COMPOSITION M.STATE M.QUERY
OP M.AFTER_ARGS COMPOSITION M.NEXT M.QUERY
OP M.BEFORE TRANSFORM M.BEFORE_ARGS memory.shortest_paths
OP M.AFTER TRANSFORM M.AFTER_ARGS memory.shortest_paths
OP M.DURATION SOURCE memory.duration
OP M.DECAY_ARGS COMPOSITION M.NEXT M.DURATION
OP M.DECAY TRANSFORM M.DECAY_ARGS memory.accessibility_decay
OP M.WITNESS COMPOSITION M.BEFORE M.AFTER M.DECAY
EMIT M.NEXT
EMIT M.WITNESS
