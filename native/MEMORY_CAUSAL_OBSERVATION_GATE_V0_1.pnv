PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# CONTRACT MEMORY_CAUSAL_OBSERVATION_GATE_V0_1
# EXECUTION_STATUS NOT_EXECUTED
# NO_NEW_TRANSFORM_BINDINGS TRUE
# The sources are independently obtained observations; this gate checks equality
# and non-equality only, not the truth, freshness or cryptography of supplied data.
OP G.CONTEXT_A SOURCE observed.context_a
OP G.CONTEXT_B SOURCE observed.context_b
OP G.CONTEXT_MATCH IDENTITY G.CONTEXT_A G.CONTEXT_B
OP G.STATE_A SOURCE observed.active_state_a
OP G.STATE_B SOURCE observed.active_state_b
OP G.STATE_MATCH IDENTITY G.STATE_A G.STATE_B
OP G.HISTORY_A SOURCE observed.history_a
OP G.HISTORY_B SOURCE observed.history_b
OP G.HISTORY_EQUAL IDENTITY G.HISTORY_A G.HISTORY_B
OP G.HISTORY_DISTINCT IDENTITY G.HISTORY_EQUAL FALSE
OP G.MEMORY_A SOURCE observed.memory_a
OP G.MEMORY_B SOURCE observed.memory_b
OP G.MEMORY_EQUAL IDENTITY G.MEMORY_A G.MEMORY_B
OP G.MEMORY_DISTINCT IDENTITY G.MEMORY_EQUAL FALSE
OP G.DELAYED SOURCE observed.memory_a_after_no_trace
OP G.PERSISTENCE IDENTITY G.MEMORY_A G.DELAYED
OP G.ROUTE_A SOURCE observed.route_a
OP G.ROUTE_B SOURCE observed.route_b
OP G.ROUTE_EQUAL IDENTITY G.ROUTE_A G.ROUTE_B
OP G.CAUSAL_DIFFERENCE IDENTITY G.ROUTE_EQUAL FALSE
OP G.FACTUAL_AFTER SOURCE observed.factual_memory_after_intervention
OP G.NO_MUTATION IDENTITY G.MEMORY_A G.FACTUAL_AFTER
OP G.DURABLE_WRITE SOURCE observed.durable_write_performed
OP G.NO_WRITE IDENTITY G.DURABLE_WRITE FALSE
OP G.CONTRACT COMPOSITION G.CONTEXT_MATCH G.STATE_MATCH G.HISTORY_DISTINCT G.MEMORY_DISTINCT G.PERSISTENCE G.CAUSAL_DIFFERENCE G.NO_MUTATION G.NO_WRITE
ASSERT G.CONTEXT_MATCH
ASSERT G.STATE_MATCH
ASSERT G.HISTORY_DISTINCT
ASSERT G.MEMORY_DISTINCT
ASSERT G.PERSISTENCE
ASSERT G.CAUSAL_DIFFERENCE
ASSERT G.NO_MUTATION
ASSERT G.NO_WRITE
EMIT G.CONTRACT
