PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# CONTRACT IMAGINARY_COLLATZ_HISTORY_V0_1
# EXECUTION_STATUS UNVERIFIED_BINDINGS
# Exact integer/rational input. Unaccelerated step; semantic event lineage is separate.
OP C.STATE SOURCE collatz.state
OP C.BIT TRANSFORM C.STATE collatz.parity
OP C.DISSOCIATE TRANSFORM C.STATE collatz.three_n
OP C.REPAIR TRANSFORM C.DISSOCIATE collatz.add_unit
OP C.SELECT_ARGS COMPOSITION C.STATE C.BIT C.REPAIR
OP C.NEXT TRANSFORM C.SELECT_ARGS collatz.select_unaccelerated
OP C.HISTORY_ARGS COMPOSITION C.STATE C.BIT C.NEXT
OP C.LIFT TRANSFORM C.HISTORY_ARGS collatz.baker_lift
OP C.INVERSE TRANSFORM C.LIFT collatz.inverse_lift
OP C.ROUNDTRIP IDENTITY C.STATE C.INVERSE
ASSERT C.ROUNDTRIP
EMIT C.LIFT
EMIT C.ROUNDTRIP
