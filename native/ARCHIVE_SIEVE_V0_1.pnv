PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# CONTRACT ARCHIVE_SIEVE_V0_1
# Static synthetic source-book example, no dynamic AUX or real archive deletion.
# Store residual 1-w as N/D. Reinforcement multiplies N by 3 and D by 4.
OP N0 SOURCE fixture.residual_numerator
OP D0 SOURCE fixture.denominator
OP RECORDS SOURCE fixture.records
OP N0_NEG DIFFERENCE 0 N0
OP D0_NEG DIFFERENCE 0 D0
OP N0_2 DIFFERENCE N0 N0_NEG
OP N1 DIFFERENCE N0_2 N0_NEG
OP D0_2 DIFFERENCE D0 D0_NEG
OP D0_2NEG DIFFERENCE 0 D0_2
OP D1 DIFFERENCE D0_2 D0_2NEG
OP N1_NEG DIFFERENCE 0 N1
OP N1_2 DIFFERENCE N1 N1_NEG
OP N2 DIFFERENCE N1_2 N1_NEG
OP D1_NEG DIFFERENCE 0 D1
OP D1_2 DIFFERENCE D1 D1_NEG
OP D1_2NEG DIFFERENCE 0 D1_2
OP D2 DIFFERENCE D1_2 D1_2NEG
OP N2_NEG DIFFERENCE 0 N2
OP N2_2 DIFFERENCE N2 N2_NEG
OP N3 DIFFERENCE N2_2 N2_NEG
OP D2_NEG DIFFERENCE 0 D2
OP D2_2 DIFFERENCE D2 D2_NEG
OP D2_2NEG DIFFERENCE 0 D2_2
OP D3 DIFFERENCE D2_2 D2_2NEG
OP W3 DIFFERENCE D3 N3
OP CHECKPOINT COMPOSITION N3 D3
OP FULL COMPOSITION CHECKPOINT RECORDS
OP SIEVED RETURN CHECKPOINT
# Separate continuation branches consume the retained sufficient state.
OP FN_NEG DIFFERENCE 0 N3
OP FN2 DIFFERENCE N3 FN_NEG
OP FN4 DIFFERENCE FN2 FN_NEG
OP FD_NEG DIFFERENCE 0 D3
OP FD2 DIFFERENCE D3 FD_NEG
OP FD2_NEG DIFFERENCE 0 FD2
OP FD4 DIFFERENCE FD2 FD2_NEG
OP FW4 DIFFERENCE FD4 FN4
OP SN SOURCE N3
OP SD SOURCE D3
OP SN_NEG DIFFERENCE 0 SN
OP SN2 DIFFERENCE SN SN_NEG
OP SN4 DIFFERENCE SN2 SN_NEG
OP SD_NEG DIFFERENCE 0 SD
OP SD2 DIFFERENCE SD SD_NEG
OP SD2_NEG DIFFERENCE 0 SD2
OP SD4 DIFFERENCE SD2 SD2_NEG
OP SW4 DIFFERENCE SD4 SN4
OP FULL_NEXT COMPOSITION FW4 FD4
OP SIEVED_NEXT COMPOSITION SW4 SD4
OP PRESERVED IDENTITY FULL_NEXT SIEVED_NEXT
OP RESET_W DIFFERENCE D1 N1
OP RESET_NEXT COMPOSITION RESET_W D1
OP RESET_EQUAL IDENTITY RESET_NEXT SIEVED_NEXT
OP RESET_DISTINCT IDENTITY RESET_EQUAL FALSE
OP W3_OK IDENTITY W3 212
OP D3_OK IDENTITY D3 320
OP W4_OK IDENTITY SW4 956
OP D4_OK IDENTITY SD4 1280
OP RESET_W_OK IDENTITY RESET_W 8
OP RESET_D_OK IDENTITY D1 20
# Source book order example A(w)=w+1, B(w)=2w.
OP A0 DIFFERENCE 0 -1
OP A0_NEG DIFFERENCE 0 A0
OP AB DIFFERENCE A0 A0_NEG
OP B0 DIFFERENCE 0 0
OP BA DIFFERENCE B0 -1
OP ORDER_EQUAL IDENTITY AB BA
OP ORDER_DISTINCT IDENTITY ORDER_EQUAL FALSE
OP AA DIFFERENCE A0 -1
OP COLLISION IDENTITY AA AB
# Source book sufficient statistic example.
OP COUNT SOURCE 20
OP WEST SOURCE 12
OP COUNT_NEXT DIFFERENCE COUNT -1
OP WEST_NEXT DIFFERENCE WEST -1
OP COUNT_OK IDENTITY COUNT_NEXT 21
OP WEST_OK IDENTITY WEST_NEXT 13
OP W3_VALUE COMPOSITION W3 D3
OP COUNTS COMPOSITION WEST_NEXT COUNT_NEXT
ASSERT PRESERVED
ASSERT RESET_DISTINCT
ASSERT W3_OK
ASSERT D3_OK
ASSERT W4_OK
ASSERT D4_OK
ASSERT RESET_W_OK
ASSERT RESET_D_OK
ASSERT ORDER_DISTINCT
ASSERT COLLISION
ASSERT COUNT_OK
ASSERT WEST_OK
EMIT W3_VALUE
EMIT FULL
EMIT SIEVED
EMIT FULL_NEXT
EMIT SIEVED_NEXT
EMIT RESET_NEXT
EMIT AB
EMIT BA
EMIT AA
EMIT COUNTS
