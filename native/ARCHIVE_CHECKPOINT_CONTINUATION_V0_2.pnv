PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# CONTRACT ARCHIVE_CHECKPOINT_CONTINUATION_V0_2
# Static synthetic checkpoint, no live AUX. Exact small integer operands.
# w=1-N/D, source positive encounter w'=w+(1-w)/4.
OP N SOURCE checkpoint.N
OP D SOURCE checkpoint.D
OP WEST SOURCE checkpoint.WEST
OP COUNT SOURCE checkpoint.COUNT
OP DETAIL SOURCE checkpoint.DETAIL
OP WEST_EVENT SOURCE input.west
OP NEG_N DIFFERENCE 0 N
OP TWO_N DIFFERENCE N NEG_N
OP N_NEXT DIFFERENCE TWO_N NEG_N
OP NEG_D DIFFERENCE 0 D
OP TWO_D DIFFERENCE D NEG_D
OP NEG_TWO_D DIFFERENCE 0 TWO_D
OP D_NEXT DIFFERENCE TWO_D NEG_TWO_D
OP W_NEXT DIFFERENCE D_NEXT N_NEXT
OP NEG_WEST_EVENT DIFFERENCE 0 WEST_EVENT
OP WEST_NEXT DIFFERENCE WEST NEG_WEST_EVENT
OP COUNT_NEXT DIFFERENCE COUNT -1
# Compare learned weight with synthetic fixed alternative 3/5.
# Signed margin numerator 5W-3D; positive favors learned route.
OP NEG_W DIFFERENCE 0 W_NEXT
OP TWO_W DIFFERENCE W_NEXT NEG_W
OP NEG_TWO_W DIFFERENCE 0 TWO_W
OP FOUR_W DIFFERENCE TWO_W NEG_TWO_W
OP FIVE_W DIFFERENCE FOUR_W NEG_W
OP NEG_D_NEXT DIFFERENCE 0 D_NEXT
OP TWO_D_NEXT DIFFERENCE D_NEXT NEG_D_NEXT
OP THREE_D DIFFERENCE TWO_D_NEXT NEG_D_NEXT
OP ROUTE_MARGIN DIFFERENCE FIVE_W THREE_D
OP DETAIL_UNAVAILABLE IDENTITY DETAIL NONE
OP WEIGHT COMPOSITION W_NEXT D_NEXT
OP COUNTS COMPOSITION WEST_NEXT COUNT_NEXT
EMIT N_NEXT
EMIT D_NEXT
EMIT WEST_NEXT
EMIT COUNT_NEXT
EMIT DETAIL
EMIT DETAIL_UNAVAILABLE
EMIT WEIGHT
EMIT COUNTS
EMIT ROUTE_MARGIN
