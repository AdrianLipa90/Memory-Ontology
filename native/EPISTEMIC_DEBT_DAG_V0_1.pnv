PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# CONTRACT EPISTEMIC_DEBT_DAG_V0_1
# Static synthetic DAG. Reachability means re-evaluation, not falsity.
# A -> B,C; B,C -> D; D -> E; B,F -> G; E,G -> H.
# A and F are separate initial correction seeds.
OP A SOURCE fixture.seed_a
OP F SOURCE fixture.seed_f
OP B IDENTITY A
OP C IDENTITY A
OP D_INPUT COMPOSITION B C
OP D_CLEAR IDENTITY D_INPUT fixture.clear_pair
OP D IDENTITY D_CLEAR FALSE
OP E IDENTITY D
OP G_INPUT COMPOSITION B F
OP G_CLEAR IDENTITY G_INPUT fixture.clear_pair
OP G IDENTITY G_CLEAR FALSE
OP H_INPUT COMPOSITION E G
OP H_CLEAR IDENTITY H_INPUT fixture.clear_pair
OP H IDENTITY H_CLEAR FALSE
OP REACH COMPOSITION A B C D E F G H
OP REACH_OK IDENTITY REACH fixture.expected_reach
ASSERT REACH_OK
# Tree unique vertices T_n = 2*T_(n-1)+1, T_0=1.
# Reconvergent layered DAG U_n = U_(n-1)+2, U_0=1.
# Both have 2^n root-to-layer paths with all edges present.
OP T0 SOURCE 1
OP U0 SOURCE 1
OP NT0 DIFFERENCE 0 T0
OP TT0 DIFFERENCE T0 NT0
OP T1 DIFFERENCE TT0 -1
OP U1 DIFFERENCE U0 -2
OP NT1 DIFFERENCE 0 T1
OP TT1 DIFFERENCE T1 NT1
OP T2 DIFFERENCE TT1 -1
OP U2 DIFFERENCE U1 -2
OP NT2 DIFFERENCE 0 T2
OP TT2 DIFFERENCE T2 NT2
OP T3 DIFFERENCE TT2 -1
OP U3 DIFFERENCE U2 -2
OP NT3 DIFFERENCE 0 T3
OP TT3 DIFFERENCE T3 NT3
OP T4 DIFFERENCE TT3 -1
OP U4 DIFFERENCE U3 -2
OP NT4 DIFFERENCE 0 T4
OP TT4 DIFFERENCE T4 NT4
OP T5 DIFFERENCE TT4 -1
OP U5 DIFFERENCE U4 -2
OP NT5 DIFFERENCE 0 T5
OP TT5 DIFFERENCE T5 NT5
OP T6 DIFFERENCE TT5 -1
OP U6 DIFFERENCE U5 -2
OP NT6 DIFFERENCE 0 T6
OP TT6 DIFFERENCE T6 NT6
OP T7 DIFFERENCE TT6 -1
OP U7 DIFFERENCE U6 -2
OP NT7 DIFFERENCE 0 T7
OP TT7 DIFFERENCE T7 NT7
OP T8 DIFFERENCE TT7 -1
OP U8 DIFFERENCE U7 -2
OP P8 DIFFERENCE T8 T7
OP TREE COMPOSITION T0 T1 T2 T3 T4 T5 T6 T7 T8
OP DAG COMPOSITION U0 U1 U2 U3 U4 U5 U6 U7 U8
OP TREE_OK IDENTITY TREE fixture.expected_tree
OP DAG_OK IDENTITY DAG fixture.expected_dag
OP PATHS_OK IDENTITY P8 256
ASSERT TREE_OK
ASSERT DAG_OK
ASSERT PATHS_OK
EMIT REACH
EMIT TREE
EMIT DAG
EMIT P8
