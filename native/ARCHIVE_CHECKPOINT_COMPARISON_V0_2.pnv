PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# CONTRACT ARCHIVE_CHECKPOINT_COMPARISON_V0_2
# Compare independently restored static synthetic continuation receipts.
OP FULL_WEIGHTS SOURCE result.full.weights
OP REDUCED_WEIGHTS SOURCE result.reduced.weights
OP RESET_WEIGHTS SOURCE result.reset.weights
OP WEIGHTS_EQUAL IDENTITY FULL_WEIGHTS REDUCED_WEIGHTS
OP RESET_EQUAL IDENTITY FULL_WEIGHTS RESET_WEIGHTS
OP RESET_DISTINCT IDENTITY RESET_EQUAL FALSE
OP FULL_COUNTS SOURCE result.full.counts
OP REDUCED_COUNTS SOURCE result.reduced.counts
OP COUNTS_EQUAL IDENTITY FULL_COUNTS REDUCED_COUNTS
OP FULL_MARGIN SOURCE result.full.margins
OP REDUCED_MARGIN SOURCE result.reduced.margins
OP MARGIN_EQUAL IDENTITY FULL_MARGIN REDUCED_MARGIN
OP RESET_MARGIN SOURCE result.reset.margins
OP RESET_MARGIN_EQUAL IDENTITY FULL_MARGIN RESET_MARGIN
OP RESET_MARGIN_DISTINCT IDENTITY RESET_MARGIN_EQUAL FALSE
OP FULL_DETAIL SOURCE result.full.detail
OP REDUCED_DETAIL SOURCE result.reduced.detail
OP FULL_AVAILABLE IDENTITY FULL_DETAIL FALSE
OP REDUCED_UNAVAILABLE IDENTITY REDUCED_DETAIL TRUE
ASSERT WEIGHTS_EQUAL
ASSERT RESET_DISTINCT
ASSERT COUNTS_EQUAL
ASSERT MARGIN_EQUAL
ASSERT RESET_MARGIN_DISTINCT
ASSERT FULL_AVAILABLE
ASSERT REDUCED_UNAVAILABLE
EMIT WEIGHTS_EQUAL
EMIT RESET_DISTINCT
EMIT COUNTS_EQUAL
EMIT MARGIN_EQUAL
EMIT RESET_MARGIN_DISTINCT
EMIT FULL_AVAILABLE
EMIT REDUCED_UNAVAILABLE
