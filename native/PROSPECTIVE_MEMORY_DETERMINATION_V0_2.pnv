PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# CONTRACT PROSPECTIVE_MEMORY_DETERMINATION_V0_2
# EXECUTION_STATUS UNVERIFIED_BINDINGS
OP D.OPPORTUNITIES SOURCE determination.comparable_opportunities
OP D.PRIOR SOURCE determination.beta_prior
OP D.ARGS COMPOSITION D.OPPORTUNITIES D.PRIOR
OP D.ESTIMATE TRANSFORM D.ARGS determination.posterior_mean
OP D.INTENTION SOURCE prospective.intention
OP D.TIME SOURCE prospective.duration
OP D.TIMESCALE SOURCE prospective.effective_timescale
OP D.HISTORY_ARGS COMPOSITION D.INTENTION D.TIME
OP D.HISTORY TRANSFORM D.HISTORY_ARGS prospective.multiply
OP D.FILTER_ARGS COMPOSITION D.INTENTION D.TIME D.TIMESCALE
OP D.EFFECTIVE TRANSFORM D.FILTER_ARGS determination.constant_intention_filter
OP D.P_ARGS COMPOSITION D.HISTORY D.ESTIMATE
OP D.P TRANSFORM D.P_ARGS prospective.multiply
OP D.EFFECTIVE_ARGS COMPOSITION D.EFFECTIVE D.ESTIMATE
OP D.P_EFFECTIVE TRANSFORM D.EFFECTIVE_ARGS prospective.multiply
OP D.ROUTES SOURCE prospective.routes
OP D.BUDGET SOURCE prospective.budget
OP D.STATUS SOURCE prospective.status
OP D.SCALE SOURCE prospective.cost_scale
OP D.ROUTE_ARGS COMPOSITION D.ROUTES D.BUDGET D.STATUS D.P D.SCALE
OP D.PROPOSAL TRANSFORM D.ROUTE_ARGS prospective.admissible_route_proposal
EMIT D.ESTIMATE
EMIT D.HISTORY
EMIT D.EFFECTIVE
EMIT D.P
EMIT D.P_EFFECTIVE
EMIT D.PROPOSAL
