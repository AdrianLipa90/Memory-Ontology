PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# CONTRACT AFFECT_CONTEXT_RECALL_FIXTURE_V0_1
# Static exact analytic fixture only. Never pass live AUX values to this receipt-hashing executor.
# Coherences are supplied analytical values, not computed by PNV.
OP A.EVENT_A SOURCE fixture.event_before
OP A.EVENT_B SOURCE fixture.event_after
OP A.EVENT_MATCH IDENTITY A.EVENT_A A.EVENT_B
OP A.CONTEXT_A SOURCE fixture.context_a
OP A.CONTEXT_B SOURCE fixture.context_b
OP A.CONTEXT_EQUAL IDENTITY A.CONTEXT_A A.CONTEXT_B
OP A.CONTEXT_DISTINCT IDENTITY A.CONTEXT_EQUAL FALSE
OP A.R11 SOURCE fixture.r11
OP A.R12 SOURCE fixture.r12
OP A.R21 SOURCE fixture.r21
OP A.R22 SOURCE fixture.r22
OP A.D1 DIFFERENCE A.R11 A.R12
OP A.D2 DIFFERENCE A.R22 A.R21
OP A.MARGIN1 IDENTITY A.D1 0.5
OP A.MARGIN2 IDENTITY A.D2 0.5
OP A.R11_EXACT IDENTITY A.R11 1
OP A.R22_EXACT IDENTITY A.R22 1
OP A.GAUGE SOURCE fixture.common_rephase_coherences
OP A.BASE COMPOSITION A.R11 A.R12 A.R21 A.R22
OP A.GAUGE_MATCH IDENTITY A.BASE A.GAUGE
OP A.RESTORE SOURCE fixture.restored_context_coherences
OP A.RESTORE_MATCH IDENTITY A.RESTORE A.BASE
ASSERT A.EVENT_MATCH
ASSERT A.CONTEXT_DISTINCT
ASSERT A.MARGIN1
ASSERT A.MARGIN2
ASSERT A.R11_EXACT
ASSERT A.R22_EXACT
ASSERT A.GAUGE_MATCH
ASSERT A.RESTORE_MATCH
EMIT A.BASE
EMIT A.D1
EMIT A.D2
