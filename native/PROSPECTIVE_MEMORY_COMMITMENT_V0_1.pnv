PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# CONTRACT PROSPECTIVE_MEMORY_COMMITMENT_V0_1
# EXECUTION_STATUS UNVERIFIED_BINDINGS
# Author: intention times time = will; will times determination = sacrifice.
OP P.INTENTION SOURCE prospective.intention
OP P.TIME SOURCE prospective.duration
OP P.DETERMINATION SOURCE prospective.determination
OP P.WILL_ARGS COMPOSITION P.INTENTION P.TIME
OP P.WILL TRANSFORM P.WILL_ARGS prospective.multiply
OP P.SACRIFICE_ARGS COMPOSITION P.WILL P.DETERMINATION
OP P.SACRIFICE TRANSFORM P.SACRIFICE_ARGS prospective.multiply
OP P.CURRENT SOURCE prospective.current_commitment
OP P.EVIDENCE SOURCE prospective.evidence
OP P.ALPHA SOURCE prospective.alpha
OP P.REVISION_ARGS COMPOSITION P.CURRENT P.EVIDENCE P.ALPHA
OP P.REVISED TRANSFORM P.REVISION_ARGS prospective.commitment_update
OP P.ROUTES SOURCE prospective.routes
OP P.BUDGET SOURCE prospective.budget
OP P.STATUS SOURCE prospective.status
OP P.SCALE SOURCE prospective.cost_scale
OP P.POLICY_ARGS COMPOSITION P.ROUTES P.BUDGET P.STATUS P.SACRIFICE P.SCALE
OP P.PROPOSAL TRANSFORM P.POLICY_ARGS prospective.admissible_route_proposal
EMIT P.WILL
EMIT P.SACRIFICE
EMIT P.REVISED
EMIT P.PROPOSAL
