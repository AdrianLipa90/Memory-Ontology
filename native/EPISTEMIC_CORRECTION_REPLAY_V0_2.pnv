PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# Static synthetic fixture. Indicators are not intent classifiers.
# All inputs are declared observations, not live AUX or personal memories.
OP KNOWN SOURCE fixture.known_verified
OP CLAIM_UNKNOWN SOURCE fixture.claim_unknown
OP IGN_PAIR COMPOSITION KNOWN CLAIM_UNKNOWN
OP IGN_CONFLICT IDENTITY IGN_PAIR fixture.true_pair
OP KNOWN_FALSE SOURCE fixture.known_false
OP CLAIM_FACT SOURCE fixture.claim_fact
OP FALSE_PAIR COMPOSITION KNOWN_FALSE CLAIM_FACT
OP FALSE_CONFLICT IDENTITY FALSE_PAIR fixture.true_pair
OP REFRAME SOURCE fixture.material_reframe
OP UNDISCLOSED SOURCE fixture.reframe_undisclosed
OP FRAME_PAIR COMPOSITION REFRAME UNDISCLOSED
OP FRAME_CONFLICT IDENTITY FRAME_PAIR fixture.true_pair
OP SUMMARY_A SOURCE fixture.summary_a
OP SUMMARY_B SOURCE fixture.summary_b
OP SAME_SUMMARY IDENTITY SUMMARY_A SUMMARY_B
OP ANSWER_A SOURCE fixture.answer_a
OP ANSWER_B SOURCE fixture.answer_b
OP SAME_ANSWER IDENTITY ANSWER_A ANSWER_B
OP DIFFERENT_ANSWER IDENTITY SAME_ANSWER FALSE
OP SIEVE_PAIR COMPOSITION SAME_SUMMARY DIFFERENT_ANSWER
OP SIEVE_CONFLICT IDENTITY SIEVE_PAIR fixture.true_pair
OP CORRECTED SOURCE fixture.prior_correction_admitted
OP OLD_MECHANISM SOURCE fixture.old_mechanism
OP NEW_MECHANISM SOURCE fixture.new_mechanism
OP SAME_MECHANISM IDENTITY OLD_MECHANISM NEW_MECHANISM
OP REPEATED_FAILURE SOURCE fixture.corrected_contract_violated
OP RECURRENCE_INPUT COMPOSITION CORRECTED SAME_MECHANISM REPEATED_FAILURE
OP RECURRENCE IDENTITY RECURRENCE_INPUT fixture.true_triple
OP NOT_EXECUTED SOURCE fixture.execution_absent
OP CLAIM_EXECUTED SOURCE fixture.claim_executed
OP EXEC_PAIR COMPOSITION NOT_EXECUTED CLAIM_EXECUTED
OP EXEC_CONFLICT IDENTITY EXEC_PAIR fixture.true_pair
OP DEBT COMPOSITION IGN_CONFLICT FALSE_CONFLICT FRAME_CONFLICT SIEVE_CONFLICT RECURRENCE EXEC_CONFLICT
OP MATCH IDENTITY DEBT fixture.expected
ASSERT MATCH
EMIT DEBT
EMIT RECURRENCE
