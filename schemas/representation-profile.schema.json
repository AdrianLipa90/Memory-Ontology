{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AdrianLipa90/Memory-Ontology/schemas/representation-profile.schema.json",
  "title": "Memory Representation Profile v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "representation_family",
    "physical_substrate_claim",
    "equivalence_contract",
    "cost_metrics",
    "evidence_status"
  ],
  "properties": {
    "schema_version": {"const": "memory-representation/v0.1"},
    "name": {"type": "string", "minLength": 1},
    "representation_family": {
      "enum": ["quantum_native", "binary", "hybrid", "substrate_neutral"]
    },
    "physical_substrate_claim": {"type": "boolean"},
    "equivalence_contract": {
      "type": "object",
      "required": ["epsilon", "horizon", "observable_contract"],
      "properties": {
        "epsilon": {"type": "number", "minimum": 0},
        "horizon": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "string", "minLength": 1}
          ]
        },
        "observable_contract": {"type": "string", "minLength": 1},
        "distance": {"type": "string"}
      },
      "additionalProperties": false
    },
    "cost_metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "storage",
          "compile_time",
          "update_time",
          "query_time",
          "sample_count",
          "sequential_depth"
        ]
      }
    },
    "evidence_status": {
      "enum": [
        "formal_only",
        "parity",
        "classical_compression",
        "candidate_q_native_advantage",
        "empirical_q_native_advantage",
        "theoretical_separation",
        "physical_quantum_necessity"
      ]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
