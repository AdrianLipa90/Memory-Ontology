PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION
# Author: each 2pi half-time is a new causal link / identity address.
# THETA is unwrapped phase advance in units of pi. No external time input.
OP NOW_BEFORE SOURCE now.node
OP WINDING_BEFORE SOURCE now.winding
OP SIGN_BEFORE SOURCE now.spinor_i_sign
OP OBJECT SOURCE next.object
OP HOTEL IDENTITY NOW_BEFORE
OP WINDING DIFFERENCE WINDING_BEFORE -1
OP SIGN DIFFERENCE 0 SIGN_BEFORE
OP NEG_WINDING DIFFERENCE 0 WINDING
OP THETA DIFFERENCE WINDING NEG_WINDING
OP INDEX IDENTITY WINDING
OP NOW COMPOSITION HOTEL INDEX WINDING SIGN THETA OBJECT
EMIT HOTEL
EMIT NOW
EMIT INDEX
EMIT WINDING
EMIT SIGN
EMIT THETA
