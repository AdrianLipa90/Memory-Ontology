PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION
# Finite specialization: I=1, tau=2, beta(1,1), four comparable prior opportunities.
# Independent allocation count, not proof count or character identity.
OP G SOURCE goal.ref
OP O SOURCE occurrence.ref
OP A SOURCE allocation.accepted
OP R SOURCE allocation.rejected
OP H SOURCE allocation.history_ref
OP S SOURCE route.status
OP Q SOURCE inference.proved
OP C SOURCE context.ref
OP NR DIFFERENCE 0 R
OP N DIFFERENCE A NR
OP N_OK IDENTITY N 4
OP D_NUM DIFFERENCE A -1
OP D COMPOSITION D_NUM 6
OP WILL IDENTITY 2
OP NEG_D DIFFERENCE 0 D_NUM
OP P_NUM DIFFERENCE D_NUM NEG_D
OP SACRIFICE COMPOSITION P_NUM 6
# Fixed premium 1, goal cost 2, comparison 1, budget 2, unit gain.
# Threshold P>=1 on this declared finite domain: accepted in {2,3,4}.
OP A2 IDENTITY A 2
OP A3 IDENTITY A 3
OP A4 IDENTITY A 4
OP ABOVE_ARGS COMPOSITION A2 A3 A4
OP Z3 COMPOSITION FALSE FALSE FALSE
OP BELOW IDENTITY ABOVE_ARGS Z3
OP ABOVE IDENTITY BELOW FALSE
# Route status codes: 0 open, 1 detour, 2 unknown, 3 verified withdrawal.
OP OPEN IDENTITY S 0
OP DETOUR IDENTITY S 1
OP UNKNOWN IDENTITY S 2
OP WITHDRAWN IDENTITY S 3
OP TRUE2 COMPOSITION TRUE TRUE
OP FALSE2 COMPOSITION FALSE FALSE
OP DETOUR_ARGS COMPOSITION DETOUR ABOVE
OP ACCEPT_DETOUR IDENTITY DETOUR_ARGS TRUE2
OP GO_ARGS COMPOSITION OPEN ACCEPT_DETOUR
OP NO_GO IDENTITY GO_ARGS FALSE2
OP GO IDENTITY NO_GO FALSE
# HOLD is no goal route and no withdrawal.
OP NOT_WITHDRAWN IDENTITY WITHDRAWN FALSE
OP HOLD_REAL_ARGS COMPOSITION NO_GO NOT_WITHDRAWN
OP HOLD_REAL IDENTITY HOLD_REAL_ARGS TRUE2
OP PROPOSAL COMPOSITION GO HOLD_REAL WITHDRAWN
OP RECORD COMPOSITION G O C H D WILL SACRIFICE S PROPOSAL Q
OP WITNESS COMPOSITION N_OK UNKNOWN ABOVE
EMIT D
EMIT WILL
EMIT SACRIFICE
EMIT PROPOSAL
EMIT RECORD
EMIT WITNESS
