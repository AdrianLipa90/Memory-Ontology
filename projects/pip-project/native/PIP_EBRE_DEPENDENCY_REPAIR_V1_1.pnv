PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION
# Fixed finite support DAG. All source flags are Boolean active premises or
# actual selected EBRE v1.0 results. Support false means NOT DERIVED, not negation.
OP TRUE2 COMPOSITION TRUE TRUE
OP FALSE2 COMPOSITION FALSE FALSE
OP FALSE3 COMPOSITION FALSE FALSE FALSE
OP TRUE1 IDENTITY TRUE
OP REF SOURCE revision.ref
OP OLD_REF SOURCE before.ref
OP NEW_REF SOURCE after.ref
OP B_PRIMARY SOURCE before.primary
OP B_PREMISES SOURCE before.premises
OP B_PROOF_REF SOURCE before.proof_ref
OP B_S SOURCE before.s
OP B_SQ SOURCE before.sq
OP B_QV SOURCE before.qv
OP B_R SOURCE before.r
OP B_RV SOURCE before.rv
OP B_VW SOURCE before.vw
OP B_ALT_ARGS COMPOSITION B_S B_SQ
OP B_ALT IDENTITY B_ALT_ARGS TRUE2
OP B_Q_ARGS COMPOSITION B_PRIMARY B_ALT
OP B_Q_NONE IDENTITY B_Q_ARGS FALSE2
OP B_Q IDENTITY B_Q_NONE FALSE
OP B_QV_ARGS COMPOSITION B_Q B_QV
OP B_QV_SUPPORT IDENTITY B_QV_ARGS TRUE2
OP B_RV_ARGS COMPOSITION B_R B_RV
OP B_RV_SUPPORT IDENTITY B_RV_ARGS TRUE2
OP B_V_ARGS COMPOSITION B_QV_SUPPORT B_RV_SUPPORT
OP B_V_NONE IDENTITY B_V_ARGS FALSE2
OP B_V IDENTITY B_V_NONE FALSE
OP B_W_ARGS COMPOSITION B_V B_VW
OP B_W IDENTITY B_W_ARGS TRUE2
OP B_STATUS COMPOSITION B_Q B_V B_W
OP B_SUPPORTS COMPOSITION B_PRIMARY B_ALT B_QV_SUPPORT B_RV_SUPPORT B_W
OP A_PRIMARY SOURCE after.primary
OP A_PREMISES SOURCE after.premises
OP A_PROOF_REF SOURCE after.proof_ref
OP A_S SOURCE after.s
OP A_SQ SOURCE after.sq
OP A_QV SOURCE after.qv
OP A_R SOURCE after.r
OP A_RV SOURCE after.rv
OP A_VW SOURCE after.vw
OP A_ALT_ARGS COMPOSITION A_S A_SQ
OP A_ALT IDENTITY A_ALT_ARGS TRUE2
OP A_Q_ARGS COMPOSITION A_PRIMARY A_ALT
OP A_Q_NONE IDENTITY A_Q_ARGS FALSE2
OP A_Q IDENTITY A_Q_NONE FALSE
OP A_QV_ARGS COMPOSITION A_Q A_QV
OP A_QV_SUPPORT IDENTITY A_QV_ARGS TRUE2
OP A_RV_ARGS COMPOSITION A_R A_RV
OP A_RV_SUPPORT IDENTITY A_RV_ARGS TRUE2
OP A_V_ARGS COMPOSITION A_QV_SUPPORT A_RV_SUPPORT
OP A_V_NONE IDENTITY A_V_ARGS FALSE2
OP A_V IDENTITY A_V_NONE FALSE
OP A_W_ARGS COMPOSITION A_V A_VW
OP A_W IDENTITY A_W_ARGS TRUE2
OP A_STATUS COMPOSITION A_Q A_V A_W
OP A_SUPPORTS COMPOSITION A_PRIMARY A_ALT A_QV_SUPPORT A_RV_SUPPORT A_W
OP SAME_PREMISES IDENTITY B_PREMISES A_PREMISES
OP CHANGE_PREMISES IDENTITY SAME_PREMISES FALSE
OP SAME_S IDENTITY B_S A_S
OP CHANGE_S IDENTITY SAME_S FALSE
OP SAME_SQ IDENTITY B_SQ A_SQ
OP CHANGE_SQ IDENTITY SAME_SQ FALSE
OP SAME_QV IDENTITY B_QV A_QV
OP CHANGE_QV IDENTITY SAME_QV FALSE
OP SAME_R IDENTITY B_R A_R
OP CHANGE_R IDENTITY SAME_R FALSE
OP SAME_RV IDENTITY B_RV A_RV
OP CHANGE_RV IDENTITY SAME_RV FALSE
OP SAME_VW IDENTITY B_VW A_VW
OP CHANGE_VW IDENTITY SAME_VW FALSE
OP SAME_Q IDENTITY B_Q A_Q
OP CHANGE_Q IDENTITY SAME_Q FALSE
OP SAME_V IDENTITY B_V A_V
OP CHANGE_V IDENTITY SAME_V FALSE
OP SAME_W IDENTITY B_W A_W
OP CHANGE_W IDENTITY SAME_W FALSE
OP Q_ROOTS COMPOSITION CHANGE_PREMISES CHANGE_S CHANGE_SQ
OP Q_STABLE IDENTITY Q_ROOTS FALSE3
OP CHECK_Q IDENTITY Q_STABLE FALSE
OP V_ROOTS COMPOSITION CHANGE_QV CHANGE_R CHANGE_RV
OP V_ROOTS_STABLE IDENTITY V_ROOTS FALSE3
OP V_STABLE_ARGS COMPOSITION Q_STABLE V_ROOTS_STABLE
OP V_STABLE IDENTITY V_STABLE_ARGS TRUE2
OP CHECK_V IDENTITY V_STABLE FALSE
OP W_STABLE_ARGS COMPOSITION V_STABLE SAME_VW
OP W_STABLE IDENTITY W_STABLE_ARGS TRUE2
OP CHECK_W IDENTITY W_STABLE FALSE
OP RECHECK COMPOSITION CHECK_Q CHECK_V CHECK_W
OP CHANGED COMPOSITION CHANGE_Q CHANGE_V CHANGE_W
OP RECORD COMPOSITION REF OLD_REF NEW_REF B_PROOF_REF A_PROOF_REF B_PREMISES A_PREMISES B_STATUS A_STATUS B_SUPPORTS A_SUPPORTS RECHECK CHANGED
EMIT B_STATUS
EMIT A_STATUS
EMIT B_SUPPORTS
EMIT A_SUPPORTS
EMIT RECHECK
EMIT CHANGED
EMIT RECORD
