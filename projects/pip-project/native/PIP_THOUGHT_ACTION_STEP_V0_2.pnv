PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# CONTRACT PIP_THOUGHT_ACTION_STEP_V0_2
# Immutable declared geometric quadrature components from source owner.
# K and U are already integrated in the same declared action unit.
OP PATH SOURCE action.path
OP CONTEXT SOURCE action.context
OP MEMORY SOURCE action.memory_ref
OP START SOURCE action.start
OP CURRENT SOURCE action.current
OP SCALE SOURCE action.scale
OP BEFORE SOURCE action.total
OP TIME SOURCE action.duration
OP COUNT SOURCE action.count
OP HISTORY SOURCE action.lineage
OP SP SOURCE segment.path
OP SC SOURCE segment.context
OP SM SOURCE segment.memory_ref
OP SS SOURCE segment.start
OP ST SOURCE segment.end
OP SL SOURCE segment.scale
OP K SOURCE segment.kinetic_integral
OP U SOURCE segment.potential_integral
OP DT SOURCE segment.duration
OP REF SOURCE segment.source_ref
OP EDGE SOURCE segment.edge
OP PATH_MATCH IDENTITY PATH SP
OP CONTEXT_MATCH IDENTITY CONTEXT SC
OP MEMORY_MATCH IDENTITY MEMORY SM
OP SCALE_MATCH IDENTITY SCALE SL
OP CONTINUITY IDENTITY CURRENT SS
OP DELTA_S DIFFERENCE K U
OP NEG_DELTA DIFFERENCE 0 DELTA_S
OP TOTAL DIFFERENCE BEFORE NEG_DELTA
OP NEG_DT DIFFERENCE 0 DT
OP DURATION DIFFERENCE TIME NEG_DT
OP N DIFFERENCE COUNT -1
OP ENTRY COMPOSITION EDGE SS ST REF K U DT DELTA_S
OP LINEAGE COMPOSITION HISTORY ENTRY
OP CHECKPOINT COMPOSITION PATH CONTEXT MEMORY START ST SCALE TOTAL DURATION N LINEAGE
OP WITNESS COMPOSITION PATH_MATCH CONTEXT_MATCH MEMORY_MATCH SCALE_MATCH CONTINUITY
EMIT DELTA_S
EMIT TOTAL
EMIT DURATION
EMIT CHECKPOINT
EMIT WITNESS
