PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# Synthetic observation test of author's effective half-time; not a runtime gate.
OP HOTEL SOURCE observation.hotel
OP FORMER_NOW SOURCE observation.previous_now
OP PAST_OK IDENTITY HOTEL FORMER_NOW
OP INDEX SOURCE observation.index
OP WINDING SOURCE observation.winding
OP OLD_INDEX SOURCE observation.previous_index
OP INDEX_NEXT DIFFERENCE OLD_INDEX -1
OP INDEX_OK IDENTITY INDEX INDEX_NEXT
OP WINDING_OK IDENTITY INDEX WINDING
OP SIGN SOURCE observation.sign
OP OLD_SIGN SOURCE observation.previous_sign
OP FLIP DIFFERENCE 0 OLD_SIGN
OP SIGN_OK IDENTITY SIGN FLIP
OP THETA SOURCE observation.theta
OP OLD_THETA SOURCE observation.previous_theta
OP STEP DIFFERENCE THETA OLD_THETA
OP HALF_TIME_OK IDENTITY STEP 2
OP NEG_INDEX DIFFERENCE 0 INDEX
OP EXPECTED_THETA DIFFERENCE INDEX NEG_INDEX
OP PHASE_OK IDENTITY THETA EXPECTED_THETA
ASSERT PAST_OK
ASSERT INDEX_OK
ASSERT WINDING_OK
ASSERT SIGN_OK
ASSERT HALF_TIME_OK
ASSERT PHASE_OK
EMIT PAST_OK
EMIT INDEX_OK
EMIT WINDING_OK
EMIT SIGN_OK
EMIT HALF_TIME_OK
EMIT PHASE_OK
