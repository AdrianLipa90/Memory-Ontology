PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION
# Finite environment: S -> G, S -> M -> G. Three independently supplied edge states.
# Inputs are a declared one-hot position and integer action 0 direct,1 first detour,2 finish,3 wait.
OP T2 COMPOSITION TRUE TRUE
OP T3 COMPOSITION TRUE TRUE TRUE
OP F2 COMPOSITION FALSE FALSE
OP F3 COMPOSITION FALSE FALSE FALSE
OP S SOURCE state.start
OP M SOURCE state.middle
OP G SOURCE state.goal
OP A SOURCE action.code
OP REF SOURCE action.ref
OP ENV SOURCE environment.ref
OP D SOURCE environment.direct
OP E SOURCE environment.first
OP F SOURCE environment.second
OP A0 IDENTITY A 0
OP A1 IDENTITY A 1
OP A2 IDENTITY A 2
OP TRYD_ARGS COMPOSITION S A0
OP TRYD IDENTITY TRYD_ARGS T2
OP TRYE_ARGS COMPOSITION S A1
OP TRYE IDENTITY TRYE_ARGS T2
OP TRYF_ARGS COMPOSITION M A2
OP TRYF IDENTITY TRYF_ARGS T2
OP MD_ARGS COMPOSITION TRYD D
OP MD IDENTITY MD_ARGS T2
OP ME_ARGS COMPOSITION TRYE E
OP ME IDENTITY ME_ARGS T2
OP MF_ARGS COMPOSITION TRYF F
OP MF IDENTITY MF_ARGS T2
OP LEAVE_S_ARGS COMPOSITION MD ME
OP LEAVE_S_NONE IDENTITY LEAVE_S_ARGS F2
OP LEAVE_S IDENTITY LEAVE_S_NONE FALSE
OP ATTEMPT_ARGS COMPOSITION TRYD TRYE TRYF
OP ATTEMPT_NONE IDENTITY ATTEMPT_ARGS F3
OP ATTEMPT IDENTITY ATTEMPT_NONE FALSE
OP MOVED_ARGS COMPOSITION MD ME MF
OP MOVED_NONE IDENTITY MOVED_ARGS F3
OP MOVED IDENTITY MOVED_NONE FALSE
OP STAY_S IDENTITY LEAVE_S FALSE
OP STAY_M IDENTITY MF FALSE
OP NS_ARGS COMPOSITION S STAY_S
OP NS IDENTITY NS_ARGS T2
OP KEEP_M_ARGS COMPOSITION M STAY_M
OP KEEP_M IDENTITY KEEP_M_ARGS T2
OP NM_ARGS COMPOSITION KEEP_M ME
OP NM_NONE IDENTITY NM_ARGS F2
OP NM IDENTITY NM_NONE FALSE
OP NG_ARGS COMPOSITION G MD MF
OP NG_NONE IDENTITY NG_ARGS F3
OP NG IDENTITY NG_NONE FALSE
OP NO_MOVE IDENTITY MOVED FALSE
OP BLOCK_ARGS COMPOSITION ATTEMPT NO_MOVE
OP BLOCKED IDENTITY BLOCK_ARGS T2
OP NEXT COMPOSITION NS NM NG
OP BEFORE COMPOSITION S M G
OP RECORD COMPOSITION ENV REF A BEFORE NEXT ATTEMPT MOVED BLOCKED NG
EMIT NEXT
EMIT ATTEMPT
EMIT MOVED
EMIT BLOCKED
EMIT NG
EMIT RECORD
