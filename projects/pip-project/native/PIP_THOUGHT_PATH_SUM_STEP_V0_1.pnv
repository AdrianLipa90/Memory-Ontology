PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# CONTRACT PIP_THOUGHT_PATH_SUM_STEP_V0_1
# A finite, already-declared common-endpoint candidate path family.
# Components come from the existing PNCS semantic U(1) transport.
# Read-only candidate arithmetic; no route selection or admission.
OP FAMILY SOURCE sum.family
OP DOMAIN SOURCE sum.domain
OP SOURCE_NODE SOURCE sum.start
OP TARGET_NODE SOURCE sum.end
OP SCALE SOURCE sum.scale
OP R SOURCE sum.real
OP I SOURCE sum.imag
OP COUNT SOURCE sum.count
OP HISTORY SOURCE sum.lineage
OP PF SOURCE path.family
OP PD SOURCE path.domain
OP PS SOURCE path.start
OP PT SOURCE path.end
OP PL SOURCE path.scale
OP PR SOURCE path.real
OP PI SOURCE path.imag
OP REF SOURCE path.ref
OP EDGES SOURCE path.edges
OP F_MATCH IDENTITY FAMILY PF
OP D_MATCH IDENTITY DOMAIN PD
OP S_MATCH IDENTITY SOURCE_NODE PS
OP T_MATCH IDENTITY TARGET_NODE PT
OP L_MATCH IDENTITY SCALE PL
OP NEG_PR DIFFERENCE 0 PR
OP NEG_PI DIFFERENCE 0 PI
OP REAL DIFFERENCE R NEG_PR
OP IMAG DIFFERENCE I NEG_PI
OP N DIFFERENCE COUNT -1
OP ENTRY COMPOSITION REF EDGES PR PI
OP LINEAGE COMPOSITION HISTORY ENTRY
OP AMPLITUDE COMPOSITION REAL IMAG
OP CHECKPOINT COMPOSITION FAMILY DOMAIN SOURCE_NODE TARGET_NODE SCALE REAL IMAG N LINEAGE
OP WITNESS COMPOSITION F_MATCH D_MATCH S_MATCH T_MATCH L_MATCH
EMIT AMPLITUDE
EMIT CHECKPOINT
EMIT WITNESS
