PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# CONTRACT PIP_CHARACTER_DEPOSIT_STEP_V0_1
# Selected immutable deterministic binary choice observations, unit weights.
# The entire explicitly selected history is the window. No runtime policy.
# Counts are exact nonnegative integers supplied by the existing source owner.
OP OWNER SOURCE deposit.owner
OP DOMAIN SOURCE deposit.query_domain
OP LABELS SOURCE deposit.candidate_labels
OP A_LABEL SOURCE deposit.label_a
OP B_LABEL SOURCE deposit.label_b
OP A SOURCE deposit.count_a
OP B SOURCE deposit.count_b
OP TOTAL SOURCE deposit.count
OP BEFORE_REF SOURCE deposit.previous_observation_ref
OP CURRENT_REF SOURCE observation.ref
OP OBS_OWNER SOURCE observation.owner
OP OBS_DOMAIN SOURCE observation.query_domain
OP OBS_LABELS SOURCE observation.candidate_labels
OP CHOICE SOURCE observation.choice
OP VA SOURCE observation.vote_a
OP VB SOURCE observation.vote_b
OP OCCURRENCE SOURCE observation.hotel_occurrence
# Typed owner/source bindings, not a new admission mechanism.
OP LABEL_PAIR COMPOSITION A_LABEL B_LABEL
OP LABEL_ORDER_MATCH IDENTITY LABEL_PAIR LABELS
OP LABEL_SAME IDENTITY A_LABEL B_LABEL
OP LABEL_DISTINCT IDENTITY LABEL_SAME FALSE
OP OWNER_MATCH IDENTITY OWNER OBS_OWNER
OP DOMAIN_MATCH IDENTITY DOMAIN OBS_DOMAIN
OP LABELS_MATCH IDENTITY LABELS OBS_LABELS
OP REF_SAME IDENTITY BEFORE_REF CURRENT_REF
OP REF_DISTINCT IDENTITY REF_SAME FALSE
OP VOTES COMPOSITION VA VB
OP OBSERVED COMPOSITION CHOICE VOTES
OP PAIR_A COMPOSITION 1 0
OP PAIR_B COMPOSITION 0 1
OP EXPECT_A COMPOSITION A_LABEL PAIR_A
OP EXPECT_B COMPOSITION B_LABEL PAIR_B
OP MATCH_A IDENTITY OBSERVED EXPECT_A
OP MATCH_B IDENTITY OBSERVED EXPECT_B
OP MATCHES COMPOSITION MATCH_A MATCH_B
OP NEITHER_PAIR COMPOSITION FALSE FALSE
OP NEITHER IDENTITY MATCHES NEITHER_PAIR
OP VOTE_MATCH IDENTITY NEITHER FALSE
OP NEG_B DIFFERENCE 0 B
OP SUM_BEFORE DIFFERENCE A NEG_B
OP TOTAL_MATCH IDENTITY SUM_BEFORE TOTAL
OP NEG_VA DIFFERENCE 0 VA
OP NEG_VB DIFFERENCE 0 VB
OP NEXT_A DIFFERENCE A NEG_VA
OP NEXT_B DIFFERENCE B NEG_VB
OP NEXT_TOTAL DIFFERENCE TOTAL -1
OP NEG_NEXT_B DIFFERENCE 0 NEXT_B
OP SUM_AFTER DIFFERENCE NEXT_A NEG_NEXT_B
OP SUM_MATCH IDENTITY SUM_AFTER NEXT_TOTAL
OP K_A COMPOSITION NEXT_A NEXT_TOTAL
OP K_B COMPOSITION NEXT_B NEXT_TOTAL
OP CHARACTER COMPOSITION K_A K_B
OP CHECKPOINT COMPOSITION OWNER DOMAIN LABELS NEXT_A NEXT_B NEXT_TOTAL CURRENT_REF
OP LINEAGE COMPOSITION BEFORE_REF CURRENT_REF OCCURRENCE
OP WITNESS COMPOSITION LABEL_ORDER_MATCH LABEL_DISTINCT OWNER_MATCH DOMAIN_MATCH LABELS_MATCH REF_DISTINCT VOTE_MATCH TOTAL_MATCH SUM_MATCH
EMIT CHARACTER
EMIT CHECKPOINT
EMIT LINEAGE
EMIT WITNESS
