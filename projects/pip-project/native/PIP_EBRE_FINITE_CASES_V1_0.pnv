PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION
# Fixed finite classical theory family; source booleans activate four clauses.
# C0=H or P; C1=not H or R; C2=not P or Q; C3=not R or Q.
# Enumerate ALL valuations with Q=false. Each active false clause eliminates a row.
OP ALL_TRUE COMPOSITION TRUE TRUE TRUE TRUE
OP T SOURCE theory.ref
OP O SOURCE occurrence.ref
OP C0 SOURCE theory.c0
OP C1 SOURCE theory.c1
OP C2 SOURCE theory.c2
OP C3 SOURCE theory.c3
OP OFF0 IDENTITY C0 FALSE
OP OFF1 IDENTITY C1 FALSE
OP OFF2 IDENTITY C2 FALSE
OP OFF3 IDENTITY C3 FALSE
OP R000_CLAUSES COMPOSITION OFF0 TRUE TRUE TRUE
OP R000 IDENTITY R000_CLAUSES ALL_TRUE
OP R001_CLAUSES COMPOSITION OFF0 TRUE TRUE OFF3
OP R001 IDENTITY R001_CLAUSES ALL_TRUE
OP R010_CLAUSES COMPOSITION TRUE TRUE OFF2 TRUE
OP R010 IDENTITY R010_CLAUSES ALL_TRUE
OP R011_CLAUSES COMPOSITION TRUE TRUE OFF2 OFF3
OP R011 IDENTITY R011_CLAUSES ALL_TRUE
OP R100_CLAUSES COMPOSITION TRUE OFF1 TRUE TRUE
OP R100 IDENTITY R100_CLAUSES ALL_TRUE
OP R101_CLAUSES COMPOSITION TRUE TRUE TRUE OFF3
OP R101 IDENTITY R101_CLAUSES ALL_TRUE
OP R110_CLAUSES COMPOSITION TRUE OFF1 OFF2 TRUE
OP R110 IDENTITY R110_CLAUSES ALL_TRUE
OP R111_CLAUSES COMPOSITION TRUE TRUE OFF2 OFF3
OP R111 IDENTITY R111_CLAUSES ALL_TRUE
OP ZEROS COMPOSITION FALSE FALSE FALSE FALSE
OP NEG_COUNTEREXAMPLES COMPOSITION R000 R001 R010 R011
OP POS_COUNTEREXAMPLES COMPOSITION R100 R101 R110 R111
OP NEG_PROVED IDENTITY NEG_COUNTEREXAMPLES ZEROS
OP POS_PROVED IDENTITY POS_COUNTEREXAMPLES ZEROS
OP BRANCHES COMPOSITION NEG_PROVED POS_PROVED
OP BOTH COMPOSITION TRUE TRUE
OP PROVED IDENTITY BRANCHES BOTH
# H=0/1,P=R=Q=1 are models for every subset, so both branches consistent.
OP NEG_MODEL COMPOSITION FALSE TRUE TRUE TRUE
OP POS_MODEL COMPOSITION TRUE TRUE TRUE TRUE
OP PREMISES COMPOSITION C0 C1 C2 C3
OP CERTIFICATE COMPOSITION T O PREMISES NEG_COUNTEREXAMPLES POS_COUNTEREXAMPLES NEG_MODEL POS_MODEL BRANCHES PROVED
EMIT CERTIFICATE
EMIT NEG_COUNTEREXAMPLES
EMIT POS_COUNTEREXAMPLES
EMIT BRANCHES
EMIT PROVED
