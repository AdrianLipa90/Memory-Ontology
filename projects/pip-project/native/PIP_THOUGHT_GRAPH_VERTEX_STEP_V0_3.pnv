PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# CONTRACT PIP_THOUGHT_GRAPH_VERTEX_STEP_V0_3
# One incoming edge contribution to a fixed target vertex/layer.
# Predecessor references point to prior layer, not expanded path histories.
OP F SOURCE vertex.family
OP C SOURCE vertex.context
OP M SOURCE vertex.memory
OP G SOURCE vertex.graph
OP S SOURCE vertex.scale
OP L SOURCE vertex.layer
OP V SOURCE vertex.node
OP X SOURCE vertex.real
OP Y SOURCE vertex.imag
OP N SOURCE vertex.count
OP H SOURCE vertex.lineage
OP P SOURCE incoming.predecessor_ref
OP E SOURCE incoming.edge_ref
OP EG SOURCE incoming.graph
OP ES SOURCE incoming.scale
OP U SOURCE incoming.source
OP T SOURCE incoming.target
OP A SOURCE incoming.action_ref
OP EX SOURCE incoming.real
OP EY SOURCE incoming.imag
OP EN SOURCE incoming.count
OP PREV DIFFERENCE L 1
OP EXPECT_P COMPOSITION F C M G S PREV U
OP REF_MATCH IDENTITY EXPECT_P P
OP TARGET_MATCH IDENTITY T V
OP GRAPH_MATCH IDENTITY EG G
OP SCALE_MATCH IDENTITY ES S
OP NX DIFFERENCE 0 EX
OP NY DIFFERENCE 0 EY
OP NN DIFFERENCE 0 EN
OP REAL DIFFERENCE X NX
OP IMAG DIFFERENCE Y NY
OP COUNT DIFFERENCE N NN
OP ENTRY COMPOSITION P E A EX EY EN
OP LINEAGE COMPOSITION H ENTRY
OP VERTEX_REF COMPOSITION F C M G S L V
OP AMPLITUDE COMPOSITION REAL IMAG
OP CHECKPOINT COMPOSITION F C M G S L V REAL IMAG COUNT LINEAGE
OP WITNESS COMPOSITION REF_MATCH TARGET_MATCH GRAPH_MATCH SCALE_MATCH
EMIT VERTEX_REF
EMIT AMPLITUDE
EMIT COUNT
EMIT CHECKPOINT
EMIT WITNESS
