PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# Static observations only: no callback, no AUX, no separate guest register.
OP PAST SOURCE observation.hotel
OP FORMER_NOW SOURCE observation.previous_now
OP EXPECTED_PAST IDENTITY PAST FORMER_NOW
OP INDEX SOURCE observation.index
OP OCCURRENCE_WINDING SOURCE observation.winding
OP INDEX_MATCH IDENTITY INDEX OCCURRENCE_WINDING
OP SIGN SOURCE observation.sign
OP OLD_SIGN SOURCE observation.previous_sign
OP FLIP DIFFERENCE 0 OLD_SIGN
OP SPIN_LIFT IDENTITY SIGN FLIP
OP THETA SOURCE observation.theta
OP OLD_THETA SOURCE observation.previous_theta
OP ELAPSED SOURCE observation.dtheta
OP THETA_STEP DIFFERENCE THETA OLD_THETA
OP ELAPSED_MATCH IDENTITY THETA_STEP ELAPSED
ASSERT EXPECTED_PAST
ASSERT INDEX_MATCH
ASSERT SPIN_LIFT
ASSERT ELAPSED_MATCH
EMIT EXPECTED_PAST
EMIT INDEX_MATCH
EMIT SPIN_LIFT
EMIT ELAPSED_MATCH
